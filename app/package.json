{
  "name": "creator-command-center",
  "version": "0.1.0",
  "description": "Creator Command Center desktop shell (Sprint 1)",
  "private": true,
  "main": "./out/main/index.js",
  "author": "Creator Command Center",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "start": "electron-vite preview",
    "package:win": "npm run build && electron-builder --win portable",
    "lint": "cd .. && eslint --config app/eslint.config.mjs app backend database automation",
    "format": "cd .. && prettier --config app/.prettierrc.json --ignore-path app/.prettierignore --write app backend database automation",
    "format:check": "cd .. && prettier --config app/.prettierrc.json --ignore-path app/.prettierignore --check app backend database automation"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "obs-websocket-js": "^5.0.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "sql.js": "^1.14.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.65.0",
    "vite": "^5.4.3"
  },
  "build": {
    "appId": "com.creatorcommandcenter.app",
    "productName": "Creator Command Center",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/sql.js/dist/*.wasm",
      "**/node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": "portable",
      "artifactName": "CreatorCommandCenter-${version}.${ext}"
    }
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "esbuild@0.21.5": true,
    "electron-winstaller@5.4.0": true,
    "ffmpeg-static@5.3.0": true
  }
}
