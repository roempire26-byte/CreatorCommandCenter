{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["electron-vite/node"],
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@database/*": ["../database/*"],
      "@backend/*": ["../backend/*"],
      "@automation/*": ["../automation/*"],
      "@content-intelligence/*": ["../content-intelligence/*"],
      "sql.js": ["node_modules/@types/sql.js"],
      "obs-websocket-js": ["node_modules/obs-websocket-js"],
      "ffmpeg-static": ["node_modules/ffmpeg-static/types/index.d.ts"]
    }
  },
  "include": [
    "electron.vite.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "../database/**/*",
    "../backend/**/*",
    "../automation/**/*",
    "../content-intelligence/**/*"
  ]
}
